{
  "name": "@dotgui/kit",
  "version": "0.4.1",
  "description": "The dotgui toolkit: parser, validator, linter, CCAC scorer, packager \u2014 and images through the Rust renderer (@dotgui/render).",
  "license": "MIT",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./types": "./src/schema/types.ts",
    "./validate": "./src/schema/validate.ts",
    "./parser": "./src/parser/index.ts",
    "./score": "./src/score/index.ts",
    "./package": "./src/package/index.ts",
    "./lint": "./src/lint/index.ts",
    "./autofix": "./src/autofix/index.ts",
    "./rasterize": "./src/rasterize/index.ts"
  },
  "bin": {
    "gui-score": "./src/score/cli.ts"
  },
  "files": [
    "src/",
    "README.md"
  ],
  "scripts": {
    "gen:spec": "bun run scripts/gen-spec.ts",
    "gen:spec:check": "bun run scripts/gen-spec.ts && git -C ../core diff --exit-code spec/spec.json",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "dotgui",
    "gui",
    "parser",
    "validate",
    "score",
    "rasterize"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/dotgui/kit"
  },
  "dependencies": {
    "@dotgui/render": "^0.4.0",
    "@xmldom/xmldom": "^0.9.10",
    "fflate": "^0.8.3"
  },
  "optionalDependencies": {
    "gui-optimizer": "*"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "bun-types": "latest",
    "typescript": "^5.0.0"
  }
}
